# Copy to .env and edit. Default is the simulator: nothing else needed.
# simulator | video | webcam
SOURCE=simulator

# Used when SOURCE=video (put the clip in backend/videos/)
VIDEO_PATH=videos/normal_flow.mp4
# Used when SOURCE=webcam
WEBCAM_INDEX=0

# Real detection shows on this camera node; N people on screen = 100% density
LIVE_NODE_ID=cam-1
LIVE_MAX_CAPACITY=30

MODEL_PATH=yolov8n.pt
CONFIDENCE=0.35
INFER_FPS=6
TICK_SECONDS=1
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
